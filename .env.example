# Firebase web app config — these values are public by design. Vite inlines them
# into the client bundle; access is enforced by Firestore Security Rules and the
# Firebase authorized-domains list. They are excluded from Netlify's secrets
# scanning in netlify.toml.
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id
VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# Public Web Push key for Firebase Cloud Messaging (the public half of a keypair).
VITE_FIREBASE_VAPID_KEY=your_public_vapid_key

# LemonSqueezy checkout links — public URLs, safe in the client bundle.
VITE_LEMON_SQUEEZY_MONTHLY_URL=https://your-store.lemonsqueezy.com/checkout/buy/xxx
VITE_LEMON_SQUEEZY_YEARLY_URL=https://your-store.lemonsqueezy.com/checkout/buy/yyy
VITE_LEMON_SQUEEZY_STORE_ID=your_store_id_here

# WARNING: the LemonSqueezy *API* key is a server-side secret. Do NOT define it
# with a VITE_ prefix — Vite would inline it into the public client bundle. If
# you need authenticated LemonSqueezy calls, move them into a Netlify Function
# and read the key there from a non-VITE_ variable (e.g. LEMON_SQUEEZY_API_KEY).
